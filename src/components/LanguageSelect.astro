---
import DefaultLanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';

// The OpenAPI plugin only generates English pages; avoid nonexistent /fr/api/ routes.
const isApiPage = Astro.url.pathname === '/api' || Astro.url.pathname.startsWith('/api/');
---

{
  isApiPage ? (
    <a href="/fr/" lang="fr" title="La référence API est disponible uniquement en anglais.">
      Guides en français
    </a>
  ) : (
    <DefaultLanguageSelect />
  )
}
