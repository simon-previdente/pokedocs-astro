---
import DefaultLanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';

// The OpenAPI plugin only generates English pages; avoid nonexistent /fr/api/ routes.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.slice(base.length);
const isApiPage = pathname === '/api' || pathname.startsWith('/api/');
---

{
  isApiPage ? (
    <a href={`${base}/fr/`} lang="fr" title="La référence API est disponible uniquement en anglais.">
      Guides en français
    </a>
  ) : (
    <DefaultLanguageSelect />
  )
}
